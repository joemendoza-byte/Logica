#include <iostream>
#include <vector>
using namespace std;
int sumarMatriz(vector<vector<int>> mat) {
    int sum = 0;
    for (int f = 0; f < mat.size(); f++) {
        for (int c = 0; c < mat[f].size(); c++) {
            sum += mat[f][c];
        }
    }
    return sum;
}
int main() {
    int f, c, n;
    cout << "Ingrese numero de filas: ";
    cin >> f;
    cout << "Ingrese numero de columnas: ";
    cin >> c;   
    vector<vector<int>> mat(f, vector<int>(c));    
    for (int i = 0; i < f; i++) {
        for (int j = 0; j < c; j++) {
            cout << "Ingrese valor [" << i << "][" << j << "]: ";
            cin >> mat[i][j];
        }
    }   
    cout << "La suma de la matriz es: " << sumarMatriz(mat) << endl;    
    return 0;
}
