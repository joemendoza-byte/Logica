//REALIZAR UN PROGRAMA QUE PERMITA VISUALIZAR A[n]={1,0,1,0,1}
#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> A;
    
    for (int i = 0; i < n; i++) {
        if (i % 2 == 0) {
            A.push_back(1);
        } else {
            A.push_back(0);
        }
    }
    cout << "A[n]={";
    for (int i = 0; i < A.size(); i++) {
        cout << A[i];
        if (i < A.size() - 1) {
            cout << ",";
        }
    }
    cout << "}";
    
    return 0;
}
