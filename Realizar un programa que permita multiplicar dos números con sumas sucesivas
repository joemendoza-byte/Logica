#include <iostream>
using namespace std;
int multiplicar(int a, int b) {
    int res = 0;
    for (int i = 0; i < b; i++) {
        res = res + a;
    }
    return res;
}
int main() {
    int a, b;
    cout << "Ingrese dos numeros: ";
    cin >> a >> b;
    cout << a << " x " << b << " = " << multiplicar(a, b) << endl;
    return 0;
}
