#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> A = {1, 2, 3, 4};
    vector<int> B = {5, 6, 7, 8};
    vector<int> C;
    
    for (int i = 0; i < A.size(); i++) {
        C.push_back(A[i] + B[i]);
    }
    
    cout << "Salida: {";
    for (int i = 0; i < C.size(); i++) {
        cout << C[i];
        if (i < C.size() - 1) {
            cout << ", ";
        }
    }
    cout << "}";
    
    return 0;
}
