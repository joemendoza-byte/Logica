#include <iostream>
using namespace std;
int potencia(int n) {
    int res = 1;
    for (int i = 0; i < n; i++) {
        res = res * n;
    }
    return res;
}
int main() {
    int n;
    cout << "Ingrese un numero: ";
    cin >> n;
    cout << n << "^" << n << " = " << potencia(n) << endl;
    return 0;
}
