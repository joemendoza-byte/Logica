#include <iostream>
#include <vector>
using namespace std;
int main() {
    vector<vector<int>> matriz = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };
    int suma = 0;
    for (int i = 0; i < matriz.size(); i++) {
        for (int j = 0; j < matriz[i].size(); j++) {
            suma += matriz[i][j];
        }
    }
    cout << "Suma de la matriz: " << suma << endl;
    return 0;
}
