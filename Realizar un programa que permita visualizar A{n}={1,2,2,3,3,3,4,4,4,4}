#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> A;
    int numero = 1;
    while (A.size() < n) {
        for (int i = 0; i < numero && A.size() < n; i++) {
            A.push_back(numero);
        }
        numero++;
    }
    cout << "A[n]={";
    for (int i = 0; i < A.size(); i++) {
        cout << A[i];
        if (i < A.size() - 1) {
            cout << ",";
        }
    }
    cout << "}";
    
    return 0;
}
