#include <iostream>
#include <vector>
using namespace std;
int main() {
    vector<int> A = {10, 20, 30, 40, 50};
    vector<int> B = {15, 25, 35, 45, 55};
    vector<int> C;
    for (int i = 0; i < A.size(); i++) {
        C.push_back(A[i]);
        C.push_back(B[i]);
    }
    cout << "C = {";
    for (int i = 0; i < C.size(); i++) {
        cout << C[i];
        if (i < C.size() - 1) {
            cout << ", ";
        }
    }
    cout << "}";
    return 0;
}










